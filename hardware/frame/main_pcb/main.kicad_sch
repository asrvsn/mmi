	(text "SW9 OFF (A): gates = source, Q4/Q6 off; plug in hot with it off.\nSW9 ON (C): R57 pulls the gates down; Vgs clamps at -12 V (D7).\nTurn-on: C54 holds Vgs ~0 at plug-in, then ~80 ms delay;\nC55 (Miller) sets dV/dt ~1 V/ms: inrush ~0.25 A into ~240 uF.\nOFF is instant (the switch shorts gate to source)."
		(exclude_from_sim no)
		(at 121.92 58.42 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "9a287116-34ab-43c7-96b6-33779700306d")
	)
