(version 1)
(rule "slot: copper 0.5 mm from the milled imaging slot"
	(constraint edge_clearance (min 0.5mm))
	(condition "A.intersectsArea('SLOT_EDGE')"))
(rule "J1: other nets' tracks 0.9 mm off the cable's wire pads (hand-soldered; v8c)"
	(constraint physical_clearance (min 0.9mm))
	(condition "A.memberOfFootprint('J1') && B.Type == 'Track' && A.Net != B.Net"))
